{
  "expo": {
    "name": "MePreparo",
    "slug": "mepreparo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mepreparo",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF8F2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "cl.mepreparo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4FB3E8"
        }
      ],
      "expo-web-browser",
      [
        "@sentry/react-native",
        {
          "organization": "vuxtrum",
          "project": "mepreparo",
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MePreparo usa la cámara para leer el ejercicio de tu cuaderno.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MePreparo usa tus fotos para leer un ejercicio que elijas.",
          "cameraPermission": "MePreparo usa la cámara para leer el ejercicio de tu cuaderno.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "17b00212-ffe1-41e3-bbf3-6c162cfcc4e6"
      }
    },
    "owner": "unkownnigga17",
    "updates": {
      "url": "https://u.expo.dev/17b00212-ffe1-41e3-bbf3-6c162cfcc4e6"
    },
    "ios": {}
  }
}
