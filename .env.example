# Copia este archivo a `.env` y completa los valores. `.env` está en .gitignore.
# Solo van aquí claves PÚBLICAS (EXPO_PUBLIC_* termina dentro de la app).
# La service_role de Supabase NUNCA va aquí: vive solo en los secretos de la Edge Function.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Sentry → Project Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Solo para subir source maps en EAS (se configura como secreto de EAS, no aquí en producción)
# SENTRY_AUTH_TOKEN=

# RevenueCat → Project settings → API keys → Public app-specific key (Android, empieza con goog_). Es pública.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Solo local (NO es EXPO_PUBLIC): header Authorization del webhook de RevenueCat. Igual al secreto de la Edge Function.
# REVENUECAT_WEBHOOK_AUTH="Bearer …"
